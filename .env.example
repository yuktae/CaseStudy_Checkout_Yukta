# Needed only to analyse new cases or re-analyse with new evidence.
# The 10 provided cases ship with pre-computed workups, so you can browse them without a key.
ANTHROPIC_API_KEY=

# Model used by the vision and assessment agents.
MODEL=claude-opus-5
ASSESS_EFFORT=high
VISION_EFFORT=medium

# Optional: require this code for uploads and re-analysis (recommended on a public URL).
DEMO_ACCESS_CODE=

# Import data/cases.json and the pre-computed workups on first start.
SEED_ON_START=true
MAX_FILES=4
MAX_FILE_MB=20
